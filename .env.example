# ============================================
# LithiumBuy Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# REQUIRED - Supabase Configuration
# ============================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ============================================
# REQUIRED - Daily.co Video Calling (TeleBuy)
# ============================================
# Get these from: https://dashboard.daily.co
VITE_DAILY_API_KEY=your-daily-api-key-here
VITE_DAILY_DOMAIN=your-domain.daily.co

# ============================================
# OPTIONAL - ElevenLabs Voice AI
# ============================================
# Only agent IDs go here (safe for frontend)
# API keys must be in Supabase Edge Function secrets!
# Get agent IDs from: https://elevenlabs.io/app/conversational-ai
VITE_ELEVENLABS_AGENT_ID=
VITE_ELEVENLABS_BUYER_AGENT_ID=
VITE_ELEVENLABS_SUPPLIER_AGENT_ID=
VITE_ELEVENLABS_CONCIERGE_AGENT_ID=

# ============================================
# INSTRUCTIONS
# ============================================
# 1. Create a Supabase project at https://supabase.com
# 2. Copy Project URL to VITE_SUPABASE_URL
# 3. Copy anon/public key to VITE_SUPABASE_ANON_KEY
# 4. (Optional) Add ElevenLabs agent IDs for voice features
#
# ⚠️ SECURITY NOTES:
# - NEVER put API keys (ElevenLabs, OpenAI, etc.) in this file
# - Private keys belong in Supabase Edge Function secrets
# - The anon key is safe to use (protected by RLS)

# ============================================================
# AIRTABLE (set as Supabase Edge Function secrets, NOT here)
# Run: supabase secrets set AIRTABLE_API_KEY=pat_xxx
# ============================================================
# AIRTABLE_API_KEY=                    # Personal Access Token (PAT) — never commit
# AIRTABLE_BASE_ID=appu9fRT4qFBCf8wL
# AIRTABLE_WEBHOOK_SECRET=             # HMAC secret for webhook verification
# -- Grant intelligence tables (IDs from Airtable API docs) --
# AIRTABLE_GRANTS_TABLE=
# AIRTABLE_GRANT_APPLICATIONS_TABLE=
# AIRTABLE_READINESS_SCORES_TABLE=
# AIRTABLE_EVIDENCE_DOCUMENTS_TABLE=
# AIRTABLE_PARTNER_MATCHING_TABLE=
# AIRTABLE_FUNDING_PIPELINE_TABLE=
# AIRTABLE_FLASH_ALERTS_TABLE=
# -- Market intelligence tables --
# AIRTABLE_MARKET_PRICES_TABLE=
# AIRTABLE_MARKET_KPIS_TABLE=
# AIRTABLE_MARKET_NEWS_TABLE=
# AIRTABLE_ARBITRAGE_TABLE=
# AIRTABLE_BRIEFINGS_TABLE=
