# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
VITE_SUPABASE_PROJECT_ID=your_project_id

# Supabase Auth Configuration
# Authentication is handled natively by Supabase
# Users are created via Supabase Auth UI or SQL
# No additional configuration needed - uses VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY above

# Development
VITE_APP_URL=http://localhost:5173

# ElevenLabs Configuration
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
VITE_ELEVENLABS_AGENT_ID=your_agent_id_here

# Airtable Configuration (for FAQ and Marketplace Data)
# Get your API key from: https://airtable.com/create/tokens
# Base ID can be found in the Airtable API documentation for your base
VITE_AIRTABLE_API_KEY=your_airtable_api_key_here
VITE_AIRTABLE_BASE_ID=your_airtable_base_id_here

# Airtable Setup Instructions:
# 1. Create an Airtable base with the following tables:
#    - FAQs (fields: Question, Answer, Category, Language, Tags, Priority)
#    - Products (fields: Name, Type, Grade, Specifications, Supplier, Price_Range, Availability, Certifications, ESG_Compliant)
# 2. Create a personal access token at https://airtable.com/create/tokens
# 3. Copy the token to VITE_AIRTABLE_API_KEY above
# 4. Get your base ID from the Airtable API documentation and add it to VITE_AIRTABLE_BASE_ID

# Daily.co Configuration (TeleBuy video calls)
# Get your API key from: https://dashboard.daily.co/developers
VITE_DAILY_API_KEY=your_daily_api_key_here

# Daily.co Setup Instructions:
# 1. Sign up at https://www.daily.co/
# 2. Go to Dashboard > Developers
# 3. Copy your API key and add it to VITE_DAILY_API_KEY above
# 4. (Optional) Configure domain settings for custom branding
