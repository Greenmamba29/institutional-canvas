# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
VITE_SUPABASE_PROJECT_ID=your_project_id

# Auth0 Configuration (Required)
# Get these from: https://manage.auth0.com/dashboard
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_client_id_here
VITE_AUTH0_AUDIENCE=https://your-api-identifier

# Auth0 Setup Instructions:
# 1. Create a new Application in Auth0 Dashboard
#    - Type: Single Page Application (React)
#    - Name: "Lithium Buy"
# 
# 2. Configure Application Settings:
#    - Allowed Callback URLs: http://localhost:5173/callback, https://your-domain.com/callback
#    - Allowed Logout URLs: http://localhost:5173, https://your-domain.com
#    - Allowed Web Origins: http://localhost:5173, https://your-domain.com
#    - Allowed Origins (CORS): http://localhost:5173, https://your-domain.com
#
# 3. Copy Domain and Client ID to this .env file
#
# 4. (Optional) Create an API in Auth0:
#    - Go to Applications > APIs > Create API
#    - Name: "Lithium Buy API"
#    - Identifier: https://api.lithiumbuy.com (or your domain)
#    - Copy Identifier to VITE_AUTH0_AUDIENCE above
#
# 5. Create 2 test users:
#    - User Management > Users > Create User
#    - User 1: buyer@test.com (password: Test1234!)
#    - User 2: supplier@test.com (password: Test1234!)
#
# 6. Get their 'sub' values:
#    - Click on each user > Details tab > User ID (looks like "auth0|abc123...")
#    - Update supabase/seed.sql with these values
#
# 7. (Optional) Configure Auth0 Action for org_id claim:
#    - See auth0-action.js for template
#    - For MVP, this is NOT required - org membership is managed in Supabase

# Development
VITE_APP_URL=http://localhost:5173

# ElevenLabs Configuration
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
VITE_ELEVENLABS_AGENT_ID=your_agent_id_here

# Airtable Configuration (for FAQ and Marketplace Data)
# Get your API key from: https://airtable.com/create/tokens
# Base ID can be found in the Airtable API documentation for your base
VITE_AIRTABLE_API_KEY=your_airtable_api_key_here
VITE_AIRTABLE_BASE_ID=your_airtable_base_id_here

# Airtable Setup Instructions:
# 1. Create an Airtable base with the following tables:
#    - FAQs (fields: Question, Answer, Category, Language, Tags, Priority)
#    - Products (fields: Name, Type, Grade, Specifications, Supplier, Price_Range, Availability, Certifications, ESG_Compliant)
# 2. Create a personal access token at https://airtable.com/create/tokens
# 3. Copy the token to VITE_AIRTABLE_API_KEY above
# 4. Get your base ID from the Airtable API documentation and add it to VITE_AIRTABLE_BASE_ID
